# ============================================================
# CBES Project Set-Up App - environment configuration
# Copy this file to ".env" and fill in the values.
# ============================================================

# --- Session ---
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Template + output locations ---------------------------
# TEMPLATES_ROOT must point at the folder that CONTAINS both
# "00 Master Projects FIle Template 0524 (Opt 2)" and "05 Forms".
# On your machine that is the OneDrive path below (keep the quotes off in .env):
# TEMPLATES_ROOT=C:\Users\FlawsA\OneDrive - City Facilities Management Holdings Ltd (1)\10. Project Set up Folder & Documents
TEMPLATES_ROOT=./sample_root

# Where generated project folders are written.
OUTPUT_ROOT=./output

# --- Authentication ----------------------------------------
# local  = simple built-in login for testing (no external dependency)
# entra  = Microsoft Entra ID (Azure AD) OIDC single sign-on
AUTH_MODE=local

# Used only when AUTH_MODE=local. Any user can sign in with this shared
# password (username is captured for the audit trail / file stamping).
LOCAL_PASSWORD=cbes

# Used only when AUTH_MODE=entra. Create an App Registration in Entra ID:
#   Redirect URI (Web):  http://localhost:8000/auth/callback
#   API permissions:     openid, profile, email, User.Read
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Behaviour toggles -------------------------------------
# Also stamp any "Date:" field with the project date (default off, because
# many forms use "Date:" for inspection/sign-off dates that must stay blank).
STAMP_DATE=false

# Overwrite existing project folder if the PJ number already exists.
OVERWRITE_EXISTING=false

# --- Optional address / map providers ----------------------
# All map features work WITHOUT these. Postcode -> area + lat/long uses the free
# postcodes.io service (no key). The Google Maps / Google Earth links are built
# from the postcode and open in the user's browser regardless.
#
# For full building-level (PAF) addresses, add a getAddress.io key — the postcode
# panel will then offer a "pick full address" dropdown.
GETADDRESS_API_KEY=
# Reserved for a future Google Maps embed (satellite/earth pane). Not required.
GOOGLE_MAPS_API_KEY=

# Note: the PM / QS / Customer dropdowns read PMs.xlsx, QS.xlsx and
# "CBES Customer List.xlsx" from TEMPLATES_ROOT (configured in
# config/departments.json -> "lookups"). Missing files just fall back to free text.
